# ConfCue environment variables — copy to .env (gitignored) or set another way.
#
# NOTE: the app does NOT auto-load a .env file (no python-dotenv). These have to
# reach the process environment. Two ways this is actually done:
#   local dev  ->  set -a; source .env; set +a   before `uv run uvicorn ...`
#   production ->  /etc/conf-cue.env, referenced by EnvironmentFile= in the
#                  systemd unit and never kept in this repo. See SETUP.md.

# Shared secret for the moderator-only delete endpoints
# (DELETE /questions/{id}, DELETE /messages/{id}).
# Unset means those endpoints reject every request — it fails closed, so leaving
# this blank is safe but disables moderation. Use a long random string.
MODERATOR_KEY=
